    family-names: Mitchell
    orcid: "https://orcid.org/0000-0003-0978-5046"
license: BSD-3-Clause
repository-code: "https://github.com/MitchellAcoustics/Soundscapy"
keywords:
  - soundscape
  - ISO 12913
  - psychoacoustics
  - acoustics
